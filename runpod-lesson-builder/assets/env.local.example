# Pod 접속값 — 이 파일을 .env.local 로 복사해서 채운다. .env.local 은 git에 올리지 않는다(.gitignore에 있음).
# tools/pod.sh·pod_get.sh(bash가 source), tools/jlab.py·check_lesson.py(직접 읽음)가 같은 값을 쓴다.
#   - 값은 따옴표·공백 없이 한 줄로 쓴다. <, >, $ 같은 기호를 넣지 않는다(bash source가 깨진다).
#   - 어디서 보나: RunPod 콘솔 → Pods → Pod 이름 → Connect 탭 → "SSH over exposed TCP"의 공인 IP와 포트.
#     Pod ID는 Pod 상세 패널에 보이는 ID(프록시 주소 <ID>-8888.proxy.runpod.net 의 앞부분과 같다).
#   - POD_<글자>_HOST·POD_<글자>_ID·POD_<글자>_PORT 값은 check_lesson.py가 공개 파일에 새지 않았는지 스캔하는 데도 쓴다.
#   - POD_<글자>_NAME은 콘솔에서 Stop할 Pod를 맞춰 고를 때 쓴다(Pods 목록의 Name).
#   - SSH 키는 ~/.ssh/id_ed25519 를 쓴다(공개키를 RunPod 계정에 등록해 둔다 — 등록은 사용자 승인 뒤).
#   - 이 파일의 값은 대화·로그·문서에 다시 출력하지 않는다.
POD_USER=root

POD_A_NAME=CHANGE_ME_pod_a_name
POD_A_HOST=CHANGE_ME_pod_a_public_ip
POD_A_PORT=CHANGE_ME_pod_a_ssh_port
POD_A_ID=CHANGE_ME_pod_a_id

# 두 번째 Pod를 쓰면 주석을 풀고 채운다(tools/pod.sh B …). 세 번째는 POD_C_… 로 같은 모양.
# POD_B_NAME=CHANGE_ME_pod_b_name
# POD_B_HOST=CHANGE_ME_pod_b_public_ip
# POD_B_PORT=CHANGE_ME_pod_b_ssh_port
# POD_B_ID=CHANGE_ME_pod_b_id
